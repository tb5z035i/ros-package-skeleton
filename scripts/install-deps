#!/usr/bin/env bash
# Run as the development user or as root in a disposable CI container.
set -eo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
source /opt/ros/jazzy/setup.bash
set -u

as_root=()
if [[ $EUID != 0 ]]; then as_root=(sudo); fi

retry_download() {
    local attempt
    for attempt in 1 2 3; do
        if "$@"; then return 0; fi
        if [[ $attempt -lt 3 ]]; then
            echo "rosdep download failed; retrying ($attempt/3)..." >&2
            sleep 2
        fi
    done
    return 1
}

"${as_root[@]}" bash scripts/configure-mirrors
export ROSDISTRO_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/rosdistro/index-v4.yaml
"${as_root[@]}" apt-get -o Acquire::Retries=3 update
retry_download rosdep update --rosdistro jazzy
rosdep install --from-paths src --ignore-src --rosdistro jazzy -y

# Apply packaging overrides here too, so local and CI builds agree.
extra=$(/usr/bin/python3 - <<'PY'
import sys
from pathlib import Path
sys.path.insert(0, 'scripts')
from deb_packaging import load_config
config = load_config(Path('packaging.toml'))
dependencies = config.get('dependencies', {})
print('\n'.join(sorted(set(dependencies.get('build', []) + dependencies.get('runtime', [])))))
PY
)
if [[ -n $extra ]]; then
    mapfile -t packages <<< "$extra"
    "${as_root[@]}" apt-get install -y --no-install-recommends "${packages[@]}"
fi
