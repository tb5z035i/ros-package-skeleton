#!/usr/bin/env bash
set -eo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
source scripts/ros-environment
source "$ROS_PREFIX/setup.bash"

export CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS:-2}
export MAKEFLAGS="-j${CMAKE_BUILD_PARALLEL_LEVEL}"
target_dir="dist/$ROS_DISTRO/$DEB_ARCH"
mkdir -p "$target_dir/test-results"
# Retain each target's logs separately when matrix artifacts are collected.
trap 'if [[ -d log ]]; then cp -a log "$target_dir/"; fi' EXIT

# Tests are advisory; build and packaging commands still fail the job.
run_test() {
    "$@" || printf 'WARNING: Test command failed (exit %s); continuing: %s\n' "$?" "$*" >&2
}

run_test /usr/bin/python3 -m pytest -q tests/test_*.py \
    --junitxml="$target_dir/test-results/packaging.xml"
colcon build --base-paths src --symlink-install --executor sequential \
    --event-handlers console_direct+ \
    --cmake-args -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
source install/setup.bash
run_test colcon test --base-paths src --executor sequential \
    --event-handlers console_direct+ --return-code-on-test-failure
run_test colcon test-result --verbose
run_test /usr/bin/python3 -m pytest -q tests/smoke_nodes.py \
    --junitxml="$target_dir/test-results/nodes.xml"

# Release tags such as v0.1.0-1 become Debian versions; other builds sort below 0.1.0.
version=${DEB_VERSION:-}
if [[ -z $version ]]; then
    if [[ -n ${CI_COMMIT_TAG:-} ]]; then
        version=${CI_COMMIT_TAG#v}
    else
        version="0.1.0~ci${CI_PIPELINE_IID:-0}+${CI_COMMIT_SHORT_SHA:-local}-1"
    fi
fi
./scripts/build-deb --version "$version" --jobs "$CMAKE_BUILD_PARALLEL_LEVEL" --output "$target_dir"
