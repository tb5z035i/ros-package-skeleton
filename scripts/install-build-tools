#!/usr/bin/env bash
# Shared by the development image and the GitLab build job; run as root.
set -euo pipefail
if [[ $EUID != 0 ]]; then
    echo 'Run this script as root (sudo bash scripts/install-build-tools).' >&2
    exit 2
fi
export DEBIAN_FRONTEND=noninteractive
bash "$(dirname "${BASH_SOURCE[0]}")/configure-mirrors"
apt-get -o Acquire::Retries=3 update
apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
    build-essential cmake dpkg-dev git openssh-client sudo \
    python3-colcon-common-extensions python3-catkin-pkg \
    python3-rosdep python3-vcstool python3-pytest
