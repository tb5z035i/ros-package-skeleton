#!/usr/bin/env bash
# Git passes a credential request on stdin. Never offer the job token off-host.
set -euo pipefail
[[ ${1:-} == get && -n ${CI_JOB_TOKEN:-} && -n ${CI_SERVER_HOST:-} ]] || exit 0
protocol='' host=''
while IFS='=' read -r key value; do
    case "$key" in
        protocol) protocol=$value ;;
        host) host=$value ;;
    esac
done
if [[ $protocol == https && ( $host == "$CI_SERVER_HOST" || $host == "$CI_SERVER_HOST:${CI_SERVER_PORT:-443}" ) ]]; then
    printf 'username=gitlab-ci-token\npassword=%s\n' "$CI_JOB_TOKEN"
fi
